{
  "name": "cesium-wind-arrows-3d",
  "version": "0.1.9",
  "description": "CesiumJS 3D wind-field arrow layer (u,v,w), WebGL2 GPGPU, height-level switching & runtime data swap | 三维风场箭头图层",
  "type": "module",
  "keywords": [
    "cesium",
    "cesiumjs",
    "wind",
    "wind-field",
    "wind-visualization",
    "3d",
    "arrow",
    "gpgpu",
    "webgl2",
    "visualization",
    "globe",
    "weather",
    "meteorology",
    "geospatial",
    "gis",
    "gpu-particles"
  ],
  "license": "MIT",
  "author": "TeleAgent",
  "contributors": [
    "rawcloud",
    "lby0102 (数据管线移植自 cesium-wind-layer-3d, MIT)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rawcloud/cesium-wind-arrows-3d.git"
  },
  "homepage": "https://github.com/Rawcloud/cesium-wind-arrows-3d#readme",
  "bugs": {
    "url": "https://github.com/Rawcloud/cesium-wind-arrows-3d/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "dev:example": "vite --config example/vite.config.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "cesium": "^1.142.0"
  },
  "devDependencies": {
    "cesium": "^1.142.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^2.3.1",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
